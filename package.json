{
  "name": "itelect4-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "try-ai": "npm run build && node dist/try-ai.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tests",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.5"
  }
}
